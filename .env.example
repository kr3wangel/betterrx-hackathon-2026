ANTHROPIC_API_KEY=
PORT=3001
# parse model — defaults to claude-haiku-4-5 (tested 6/6 on the spec messages)
PARSE_MODEL=
# delivery window for stat/urgent orders with no explicit deadline — same-day assumption (default 8)
SLA_STAT_HOURS=
# delivery window for routine orders with no explicit deadline (default 24)
SLA_ROUTINE_HOURS=
# hours before a pending pickup is flagged overdue (default 24; set low to demo)
PICKUP_WINDOW_HOURS=
# hours an order can sit unconfirmed before the vendor gets an SMS nag (default 2; set low to demo)
ACK_NAG_HOURS=
# hours of continued silence after the nag before the case manager is escalated (default 2; set low to demo)
ACK_ESCALATE_HOURS=
# local hour the morning-of "are you on schedule?" text goes out to vendors (default 8; set to 0 to demo)
ETA_CHECK_HOUR=
